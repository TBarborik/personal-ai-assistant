// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Conversation {
  id        String    @id @default(cuid())
  title     String    @default("Nová konverzace") @db.VarChar(255)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([updatedAt])
}

model Message {
  id             String       @db.VarChar(191)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  role           String       @db.VarChar(20)
  parts          Json
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@id([conversationId, id])
  @@index([conversationId, createdAt])
}

model Document {
  id           String          @id @default(uuid())
  name         String
  storageKey   String          @unique
  mimeType     String
  size         Int
  status       DocumentStatus  @default(UPLOADED)
  errorMessage String?         @db.Text
  content      String?         @db.LongText
  chunks       DocumentChunk[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  indexedAt DateTime?
}

model DocumentChunk {
  id             String   @id @default(uuid())
  documentId     String
  position       Int
  content        String   @db.Text
  createdAt      DateTime @default(now())
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  embedding      Json?
  embeddingModel String?

  @@unique([documentId, position])
}

model Usage {
  id               String      @id @default(uuid())
  conversationId   String?
  messageId        String?
  provider         String
  model            String
  costUsd          Decimal?    @db.Decimal(18, 10)
  inputTokens      Int?
  outputTokens     Int?
  totalTokens      Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?
  reasoningTokens  Int?
  durationMs       Int?
  stepCount        Int
  toolCallCount    Int
  finishReason     String
  steps            UsageStep[]
  createdAt        DateTime    @default(now())

  @@index([createdAt])
  @@index([provider, model, createdAt])
  @@index([conversationId, messageId])
}

model UsageStep {
  int              String   @id @default(uuid())
  usage            Usage?   @relation(fields: [usageId], references: [id], onDelete: Cascade)
  usageId          String?
  position         Int
  provider         String
  model            String
  costUsd          Decimal? @db.Decimal(18, 10)
  inputTokens      Int?
  outputTokens     Int?
  totalTokens      Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?
  reasoningTokens  Int?
  finishReason     String
  toolCalls        Json

  @@unique([usageId, position])
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}
